<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="10dp"
    android:paddingBottom="13dp">

    <ImageView
        android:id="@+id/ivCarRowIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="车辆"
        android:src="@drawable/ic_c_nav_car"
        android:tint="@color/txt_tertiary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCarRowName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="车辆"
                android:textColor="@color/txt_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCarRowCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="当前"
                android:textColor="@color/brand"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCarRowSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="--"
            android:textColor="@color/txt_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnCarEdit"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="修改名称"
        android:padding="8dp"
        android:src="@drawable/ic_c_edit"
        android:tint="@color/txt_tertiary" />
</LinearLayout>
