<?xml version="1.0" encoding="utf-8"?>
<!--
  控车页单个功能块。
  根布局是 FrameLayout，为的是让「调宽度」按钮浮在右上角；
  内容区沿用原来的图标 + 文字居中排布。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:id="@+id/tileBody"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTile"
            style="@style/TileIcon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvTile"
            style="@style/TileLabel" />
    </LinearLayout>

    <!-- 编辑态才出现的调宽度按钮 -->
    <ImageView
        android:id="@+id/btnResize"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_card"
        android:contentDescription="调整宽度"
        android:padding="2dp"
        android:src="@drawable/ic_c_maximize"
        android:tint="@color/brand"
        android:visibility="gone" />
</FrameLayout>
